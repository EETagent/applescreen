+TEST_F(TlsConnectionFactoryPosixTest, OccupiedPortReturnsErrorWithoutAbort) {
+  auto key = GenerateRsaKeyPair();
+  ASSERT_TRUE(key);
+  auto cert = CreateSelfSignedX509Certificate("listen test", std::chrono::hours(1), *key);
+  ASSERT_TRUE(cert);
+  auto der = ExportX509CertificateToDer(*cert.value());
+  ASSERT_TRUE(der);
+  uint8_t* bytes = nullptr;
+  size_t size = 0;
+  ASSERT_TRUE(RSA_private_key_to_bytes(&bytes, &size, EVP_PKEY_get0_RSA(key.get())));
+  TlsCredentials credentials;
+  credentials.der_rsa_private_key.assign(bytes, bytes + size);
+  OPENSSL_free(bytes);
+  credentials.der_x509_cert = std::move(der.value());
+  ASSERT_TRUE(factory_.SetListenCredentials(credentials).ok());
+
+  const int fd = socket(AF_INET, SOCK_STREAM, 0);
+  ASSERT_GE(fd, 0);
+  // Keep the OS-assigned port reserved throughout the test, with no sleeps.
+  struct CloseSocket { int fd; ~CloseSocket() { close(fd); } } owner{fd};
+  sockaddr_in address{};
+  address.sin_family = AF_INET;
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  ASSERT_EQ(bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)), 0);
+  ASSERT_EQ(listen(fd, 8), 0);
+  socklen_t length = sizeof(address);
+  ASSERT_EQ(getsockname(fd, reinterpret_cast<sockaddr*>(&address), &length), 0);
+  EXPECT_CALL(client_, OnError(&factory_, testing::_)).Times(1);
+  EXPECT_EQ(factory_.Listen({{127, 0, 0, 1}, ntohs(address.sin_port)}, {8}).code(),
+            Error::Code::kSocketBindFailure);
+  task_runner_.RunTasksUntilIdle();
+}
