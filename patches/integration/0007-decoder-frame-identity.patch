+constexpr size_t kAccessUnits[] = {0, 60, 84, 100, 117, 147, 165, 182, 212, 230, 247, 277, 295, 312, 339, 357, 374, 404, 422, 439, 469, 487, 504, 537, 554};
+// FrameId is based on access-unit/decode order. Presentation order must reorder
+// these identities along with the pictures rather than advance a FIFO counter.
+constexpr int kPresentationOrder[] = {0, 2, 3, 1, 5, 6, 4, 8, 9, 7, 11, 12,
+                                      10, 14, 15, 13, 17, 18, 16, 20, 21, 19, 23, 22};
+
+class DecodedFrames : public Decoder::Client {
+ public:
+  void OnFrameDecoded(FrameId id, const AVFrame& frame) override {
+    ids.push_back(id);
+    luma.push_back(frame.data[0][0]);
+  }
+  void OnDecodeError(FrameId id, const std::string&) override { errors.push_back(id); }
+  void OnFatalError(const std::string& error) override { fatal.push_back(error); }
+  std::vector<FrameId> ids;
+  std::vector<uint8_t> luma;
+  std::vector<FrameId> errors;
+  std::vector<std::string> fatal;
+};
+TEST(DecoderTest, DelayedReorderedFramesKeepInputIdentity) {
+  Decoder decoder("h264");
+  DecodedFrames output;
+  decoder.set_client(&output);
+  for (size_t i = 0; i + 1 < std::size(kAccessUnits); ++i) {
+    Decoder::Buffer input;
+    input.Resize(kAccessUnits[i + 1] - kAccessUnits[i]);
+    std::memcpy(input.AsByteBuffer().data(), kReorderedH264 + kAccessUnits[i],
+                input.AsByteView().size());
+    decoder.Decode(FrameId(100 + i * 7), input);
+    // Input storage is immediately reused/freed; libavcodec owns buffered data.
+    std::fill(input.AsByteBuffer().begin(), input.AsByteBuffer().end(), 0);
+  }
+  ASSERT_TRUE(output.fatal.empty());
+  ASSERT_TRUE(output.errors.empty());
+  ASSERT_GE(output.ids.size(), 6u);  // Some final frames remain codec-buffered.
+  ASSERT_LE(output.ids.size(), std::size(kPresentationOrder));
+  for (size_t i = 0; i < output.ids.size(); ++i) {
+    EXPECT_EQ(output.ids[i], FrameId(100 + kPresentationOrder[i] * 7));
+    EXPECT_NEAR(output.luma[i], 16 + i * 8, 2);
+  }
+  EXPECT_NE(output.ids[1], FrameId(107));  // Explicitly catches the old FIFO.
+}
+TEST(DecoderTest, EmptyInputReportsOnlyItsOwnIdentity) {
+  Decoder decoder("h264");
+  DecodedFrames output;
+  decoder.set_client(&output);
+  Decoder::Buffer empty;
+  decoder.Decode(FrameId(73), empty);
+  ASSERT_EQ(output.errors.size(), 1u);
+  EXPECT_EQ(output.errors[0], FrameId(73));
+  EXPECT_TRUE(output.ids.empty());
+  EXPECT_TRUE(output.fatal.empty());
+}
