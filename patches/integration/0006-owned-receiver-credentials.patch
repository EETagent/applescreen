+
+#include "cast/receiver/channel/static_credentials.h"
+
+#include <openssl/pem.h>
+
+#include <string>
+
+#include "third_party/googletest/src/googletest/include/gtest/gtest.h"
+#include "util/crypto/certificate_utils.h"
+
+namespace openscreen::cast {
+namespace {
+std::string Pem(BIO* output) {
+  char* data = nullptr;
+  const long size = BIO_get_mem_data(output, &data);
+  return std::string(data, size);
+}
+class OwnedReceiverCredentialsTest : public testing::Test {
+ protected:
+  void SetUp() override {
+    key = GenerateRsaKeyPair();
+    ASSERT_TRUE(key);
+    bssl::UniquePtr<BIO> output(BIO_new(BIO_s_mem()));
+    ASSERT_EQ(PEM_write_bio_PrivateKey(output.get(), key.get(), nullptr, nullptr, 0,
+                                     nullptr, nullptr), 1);
+    private_key = Pem(output.get());
+  }
+  std::string Certificate(bool ca, std::chrono::seconds issued, std::chrono::seconds valid) {
+    auto certificate = CreateSelfSignedX509Certificate("Developer CA", valid, *key, issued, ca);
+    EXPECT_TRUE(certificate);
+    if (!certificate) return {};
+    bssl::UniquePtr<BIO> output(BIO_new(BIO_s_mem()));
+    EXPECT_EQ(PEM_write_bio_X509(output.get(), certificate.value().get()), 1);
+    return Pem(output.get());
+  }
+  bssl::UniquePtr<EVP_PKEY> key;
+  std::string private_key;
+};
+TEST_F(OwnedReceiverCredentialsTest, ValidAuthorityProducesNormalDeviceChainAndTls) {
+  auto ca = Certificate(true, GetWallTimeSinceUnixEpoch() - std::chrono::seconds(1),
+                        std::chrono::hours(24));
+  auto result = GenerateCredentialsFromPem("test-device", private_key, ca);
+  ASSERT_TRUE(result);
+  EXPECT_EQ(result.value().provider->device_creds.certs.size(), 2u);
+  EXPECT_FALSE(result.value().root_cert_der.empty());
+  EXPECT_EQ(result.value().provider->tls_cert_der,
+            result.value().tls_credentials.der_x509_cert);
+  // Returned credentials have no borrowed input; mutation cannot alter them.
+  private_key.clear(); ca.clear();
+  EXPECT_FALSE(result.value().provider->GetCurrentTlsCertAsDer().empty());
+}
+TEST_F(OwnedReceiverCredentialsTest, RejectsMalformedMismatchedAndInvalidAuthority) {
+  const auto now = GetWallTimeSinceUnixEpoch();
+  const auto valid = Certificate(true, now - std::chrono::seconds(1), std::chrono::hours(24));
+  for (const std::string& bad : {std::string(), std::string("garbage"), valid.substr(0, valid.size()/2), valid + "junk", "junk" + valid, valid + valid}) {
+    EXPECT_FALSE(GenerateCredentialsFromPem("device", private_key, bad));
+    EXPECT_FALSE(GenerateCredentialsFromPem("device", bad, valid));
+  }
+  auto other_key = GenerateRsaKeyPair();
+  auto other_ca = CreateSelfSignedX509Certificate("Other CA", std::chrono::hours(24),
+      *other_key, now - std::chrono::seconds(1), true);
+  ASSERT_TRUE(other_ca);
+  bssl::UniquePtr<BIO> output(BIO_new(BIO_s_mem()));
+  ASSERT_EQ(PEM_write_bio_X509(output.get(), other_ca.value().get()), 1);
+  EXPECT_FALSE(GenerateCredentialsFromPem("device", private_key, Pem(output.get())));
+  for (const auto& ca : {Certificate(false, now - std::chrono::seconds(1), std::chrono::hours(24)),
+                  Certificate(true, now - std::chrono::hours(2), std::chrono::hours(1)),
+                  Certificate(true, now + std::chrono::hours(1), std::chrono::hours(24))}) {
+    EXPECT_FALSE(GenerateCredentialsFromPem("device", private_key, ca));
+  }
+  EXPECT_FALSE(GenerateCredentialsFromPem("", private_key, valid));
+}
