+ErrorOr<GeneratedCredentials> GenerateCredentialsFromPem(
+    const std::string& device_certificate_id,
+    std::string_view private_key_pem,
+    std::string_view root_certificate_pem) {
+  if (private_key_pem.empty() || root_certificate_pem.empty() ||
+      private_key_pem.size() > std::numeric_limits<int>::max() ||
+      root_certificate_pem.size() > std::numeric_limits<int>::max()) {
+    return Error(Error::Code::kParameterInvalid, "Missing or oversized credentials");
+  }
+  // Reject ignored prefixes, extra PEM objects and trailing non-whitespace.
+  // The selected authority is one explicit certificate, not a best-effort scan.
+  auto single_pem = [](std::string_view pem, std::string_view label) {
+    constexpr std::string_view whitespace = " \t\r\n\f\v";
+    const size_t first = pem.find_first_not_of(whitespace);
+    if (first == std::string_view::npos) return false;
+    pem.remove_prefix(first);
+    const std::string begin = "-----BEGIN " + std::string(label) + "-----";
+    const std::string end = "-----END " + std::string(label) + "-----";
+    const size_t last = pem.find(end);
+    return pem.starts_with(begin) && last != std::string_view::npos &&
+           pem.substr(last + end.size()).find_first_not_of(whitespace) == std::string_view::npos;
+  };
+  if (!single_pem(root_certificate_pem, "CERTIFICATE") ||
+      (!single_pem(private_key_pem, "RSA PRIVATE KEY") &&
+       !single_pem(private_key_pem, "PRIVATE KEY"))) {
+    return Error(Error::Code::kParseError, "Expected one unencrypted key and one CA certificate");
+  }
+  bssl::UniquePtr<BIO> key_input(BIO_new_mem_buf(private_key_pem.data(), private_key_pem.size()));
+  bssl::UniquePtr<BIO> ca_input(BIO_new_mem_buf(root_certificate_pem.data(), root_certificate_pem.size()));
+  if (!key_input || !ca_input) return Error(Error::Code::kEVPInitializationError);
+  bssl::UniquePtr<EVP_PKEY> key(PEM_read_bio_PrivateKey(key_input.get(), nullptr,
+      [](char*, int, int, void*) { return 0; }, nullptr));
+  bssl::UniquePtr<X509> ca(PEM_read_bio_X509(ca_input.get(), nullptr, nullptr, nullptr));
+  if (!key || !ca) {
+    ClearOpenSSLERRStack(CURRENT_LOCATION);
+    return Error(Error::Code::kParseError, "Invalid or encrypted PEM credentials");
+  }
+  auto result = GenerateCredentials(device_certificate_id, key.get(), ca.get());
+  if (!result) ClearOpenSSLERRStack(CURRENT_LOCATION);
+  return result;
+}
