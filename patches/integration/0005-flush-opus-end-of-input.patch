+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "cast/standalone_sender/streaming_opus_encoder.h"
+
+#include <opus/opus.h>
+
+#include <cmath>
+#include <vector>
+
+#include "cast/standalone_sender/testing/fake_sender.h"
+#include "gtest/gtest.h"
+
+namespace openscreen::cast {
+namespace {
+class AudioSender final : public FakeSender {
+ public:
+  explicit AudioSender(int channels) : config_(FakeSender::config()) {
+    config_.rtp_timebase = 48000;
+    config_.channels = channels;
+  }
+  const SessionConfig& config() const override { return config_; }
+  EnqueueFrameResult EnqueueFrame(const EncodedFrame& frame) override {
+    packets.emplace_back(frame.data.begin(), frame.data.end());
+    references.push_back(frame.reference_time);
+    captures.push_back(frame.capture_end_time);
+    timestamps.push_back(frame.rtp_timestamp);
+    return FakeSender::EnqueueFrame(frame);
+  }
+  SessionConfig config_;
+  std::vector<std::vector<uint8_t>> packets;
+  std::vector<Clock::time_point> references, captures;
+  std::vector<RtpTimeTicks> timestamps;
+};
+}  // namespace
+
+TEST(StreamingOpusEncoderTest, FlushPreservesFinalSamplesAndIsIdempotent) {
+  const auto origin = Clock::time_point(std::chrono::seconds(1));
+  const auto reference = origin + std::chrono::milliseconds(250);
+  for (int channels : {1, 2}) {
+    for (int count : {0, 1, 479, 480, 481, 959, 960, 2000}) {
+      auto sender = std::make_unique<AudioSender>(channels);
+      auto* recorded = sender.get();
+      StreamingOpusEncoder encoder(channels, 100, std::move(sender));
+      encoder.Flush();
+      EXPECT_TRUE(recorded->packets.empty());
+      std::vector<float> input(count * channels);
+      for (int i = std::max(0, count - 480); i < count; ++i) {
+        for (int channel = 0; channel < channels; ++channel) {
+          input[i * channels + channel] = 0.5f * std::sin(i * 0.2f);
+        }
+      }
+      if (count) {
+        encoder.EncodeAndSend(input.data(), count, origin, origin, reference);
+      }
+      encoder.Flush();
+      const auto packets = recorded->packets.size();
+      encoder.Flush();
+      EXPECT_EQ(recorded->packets.size(), packets);
+      if (!count) {
+        EXPECT_EQ(packets, 0u);
+        continue;
+      }
+      const auto delay = reference - recorded->references.front();
+      const int lookahead = std::chrono::duration_cast<std::chrono::microseconds>(delay).count() * 48000 / 1000000;
+      EXPECT_GT(lookahead, 0);
+      EXPECT_EQ(packets, static_cast<size_t>((count + lookahead + 479) / 480));
+      int error = 0;
+      OpusDecoder* decoder = opus_decoder_create(48000, channels, &error);
+      ASSERT_EQ(error, OPUS_OK);
+      std::vector<float> decoded(packets * 480 * channels);
+      for (size_t i = 0; i < packets; ++i) {
+        EXPECT_EQ(opus_decode_float(decoder, recorded->packets[i].data(),
+                    recorded->packets[i].size(), decoded.data() + i * 480 * channels,
+                    480, 0), 480);
+        EXPECT_EQ(recorded->references[i], reference - delay + std::chrono::milliseconds(10 * i));
+        EXPECT_EQ(recorded->captures[i], origin);  // No future capture time invented.
+        if (i) EXPECT_EQ(recorded->timestamps[i] - recorded->timestamps[i - 1], RtpTimeDelta::FromTicks(480));
+      }
+      opus_decoder_destroy(decoder);
+      for (float sample : decoded) EXPECT_TRUE(std::isfinite(sample));
+      if (count == 2000) {
+        double energy = 0;
+        for (int i = lookahead + count - 240; i < lookahead + count; ++i)
+          energy += std::abs(decoded[i * channels]);
+        EXPECT_GT(energy, 5.0);  // The audible tail emerges from actual Opus decode.
+      }
+    }
+  }
+}
+}  // namespace openscreen::cast
