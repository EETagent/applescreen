 #include "platform/base/span.h"
 #include "util/chrono_helpers.h"
@@ -91,6 +92,10 @@ void StreamingOpusEncoder::EncodeAndSend(const float* interleaved_samples,
   OSP_CHECK(interleaved_samples);
   OSP_CHECK_GT(num_samples, 0);
 
+  flushed_ = false;
+  last_capture_begin_time_ = capture_begin_time;
+  last_capture_end_time_ = capture_end_time;
+
   ResolveTimestampsAndMaybeSkip(reference_time);
 
   while (num_samples > 0) {
@@ -143,6 +148,29 @@ void StreamingOpusEncoder::EncodeAndSend(const float* interleaved_samples,
   }
 }
 
+void StreamingOpusEncoder::Flush() {
+  if (flushed_) {
+    return;
+  }
+  opus_int32 lookahead = 0;
+  OSP_CHECK_EQ(opus_encoder_ctl(encoder(), OPUS_GET_LOOKAHEAD(&lookahead)),
+               OPUS_OK);
+  // Opus retains lookahead even when the input ended on a packet boundary.
+  // Pad that delay as well, or the last real samples would remain unencoded.
+  const int remainder = (num_samples_queued_ + lookahead) % samples_per_cast_frame_;
+  const int padding = lookahead +
+      (remainder ? samples_per_cast_frame_ - remainder : 0);
+  if (padding > 0) {
+    const std::vector<float> silence(num_channels_ * padding, 0.0f);
+    const auto next_sample_time = frame_.reference_time + codec_delay_ +
+        RtpTimeDelta::FromTicks(num_samples_queued_)
+            .ToDuration<Clock::duration>(sample_rate());
+    EncodeAndSend(silence.data(), padding, last_capture_begin_time_,
+                  last_capture_end_time_, next_sample_time);
+  }
+  flushed_ = true;
+}
