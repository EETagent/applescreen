diff --git a/cast/standalone_sender/streaming_queue_unittest.cc b/cast/standalone_sender/streaming_queue_unittest.cc
new file mode 100644
index 00000000..86d9cf58
--- /dev/null
+++ b/cast/standalone_sender/streaming_queue_unittest.cc
@@ -0,0 +1,46 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "cast/standalone_sender/streaming_vpx_encoder.h"
+
+#include <vector>
+
+#include "cast/standalone_sender/testing/fake_sender.h"
+#include "gtest/gtest.h"
+#include "platform/test/fake_clock.h"
+#include "platform/test/fake_task_runner.h"
+
+namespace openscreen::cast {
+TEST(StreamingQueueTest, BoundsRawAndUndeliveredFramesBeforeFirstPacket) {
+  FakeClock clock(Clock::now());
+  FakeTaskRunner runner(clock);
+  for (auto codec : {VideoCodec::kVp8, VideoCodec::kVp9}) {
+    StreamingVideoEncoder::Parameters params;
+    params.codec = codec;
+    params.max_pending_frames = 2;
+    {
+      StreamingVpxEncoder encoder(params, runner, std::make_unique<FakeSender>());
+      // The source is deliberately reused/freed before the encoder is joined.
+      // No owner tasks run, even if encoding finishes quickly on this machine.
+      {
+        std::vector<uint8_t> y(16 * 16, 128), u(8 * 8, 64), v(8 * 8, 192);
+        StreamingVideoEncoder::VideoFrame frame;
+        frame.width = frame.height = 16;
+        frame.yuv_planes[0] = y.data();
+        frame.yuv_planes[1] = u.data();
+        frame.yuv_planes[2] = v.data();
+        frame.yuv_strides[0] = 16;
+        frame.yuv_strides[1] = frame.yuv_strides[2] = 8;
+        frame.duration = std::chrono::milliseconds(16);
+        for (int i = 0; i < 100; ++i) {
+          frame.capture_begin_time = frame.capture_end_time = clock.now();
+          encoder.EncodeAndSend(frame, clock.now() + i * frame.duration, {});
+          std::fill(y.begin(), y.end(), static_cast<uint8_t>(i));
+        }
+      }
+      EXPECT_EQ(encoder.pending_frames(), 2u);
+    }  // Join before touching FakeTaskRunner's result queue.
+    runner.RunTasksUntilIdle();
+  }
+}
+}  // namespace openscreen::cast
