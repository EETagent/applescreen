diff --git a/cast/sender/channel/sender_socket_factory.cc b/cast/sender/channel/sender_socket_factory.cc
index 7a8d7485..e2697826 100644
--- a/cast/sender/channel/sender_socket_factory.cc
+++ b/cast/sender/channel/sender_socket_factory.cc
@@ -108,6 +108,17 @@ void SenderSocketFactory::OnConnected(
                       std::move(peer_cert.value())});
   PendingAuth& pending = *pending_auth_.back();
 
+  // If skip_authentication_ is set, bypass the auth challenge and connect directly.
+  if (skip_authentication_) {
+    OSP_LOG_WARN << "Skipping certificate authentication for " << endpoint
+                 << " (development mode)";
+    pending.socket->SetClient(pending.client);
+    client_.OnConnected(this, pending.endpoint,
+                        std::unique_ptr<CastSocket>(pending.socket.release()));
+    pending_auth_.pop_back();
+    return;
+  }
+
   CastMessage auth_challenge =
       CreateAuthChallengeMessage(*pending.auth_context);
   Error error = pending.socket->Send(auth_challenge);
